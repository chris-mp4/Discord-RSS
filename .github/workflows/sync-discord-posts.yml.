name: Sync Discord posts

on:
  schedule:
    - cron: '0 * * * *'
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Fetch Discord messages
        env:
          DISCORD_TOKEN: ${{ secrets.DISCORD_TOKEN }}
          DISCORD_CHANNEL_ID: ${{ secrets.DISCORD_CHANNEL_ID }}
        run: node fetch-discord.js

      - name: Commit updated posts
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add posts.json
          git diff --quiet && git diff --staged --quiet || git commit -m "Update posts from Discord"
          git push
